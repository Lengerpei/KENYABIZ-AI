# KenyaBiz AI environment configuration

# Groq API key used by the Supervisor Agent

GROQ_API_KEY=your_groq_api_key

# Optional: custom SQLite database location

# Leave blank to use the application's default database location

KENYABIZ_DATABASE=

# Default delivery fee used by the quotation/order workflow

DEFAULT_DELIVERY_FEE=2500

# Currency used for prices, quotations, invoices and payments

CURRENCY=KES
